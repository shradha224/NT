generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id             Int      @id @default(autoincrement())
  email          String?  @unique
  phone          String?  @unique
  passwordHash   String
  name           String
  role           String   // FARMER, AGGREGATOR
  biometricId    String?  // [future]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  
  batches        Batch[]
}

model Batch {
  id               Int      @id @default(autoincrement())
  batchId          String   @unique
  farmerId         Int
  farmer           User     @relation(fields: [farmerId], references: [id])
  produceType      String
  variety          String
  quantity         Float
  harvestDate      DateTime
  origin           String
  status           String   // CREATED, MONITORING_PENDING, MONITORED, IN_TRANSIT, DISTRIBUTED, COMPLETED
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  
  assessments      QualityAssessment[]
  sensorReadings   SensorReading[]
  sessions         MonitoringSession[]
}

model Device {
  id               Int      @id @default(autoincrement())
  deviceId         String   @unique
  aggregatorId     Int?
  status           String   // ONLINE, WARNING, OFFLINE, ERROR
  cameraStatus     String?
  tempStatus       String?
  humidityStatus   String?
  vocStatus        String?
  lastSeen         DateTime?
  updatedAt        DateTime @updatedAt
  
  sensorReadings   SensorReading[]
  sessions         MonitoringSession[]
}

model SensorReading {
  id             Int      @id @default(autoincrement())
  batchId        Int
  batch          Batch    @relation(fields: [batchId], references: [id])
  deviceId       Int
  device         Device   @relation(fields: [deviceId], references: [id])
  timestamp      DateTime
  temperature    Float?
  humidity       Float?
  voc            Float?
  syncStatus     String   // PENDING, SYNCED
  createdAt      DateTime @default(now())
}

model QualityAssessment {
  id                 Int      @id @default(autoincrement())
  batchId            Int
  batch              Batch    @relation(fields: [batchId], references: [id])
  assessorId         Int
  conditionScore     Int
  spoilageRisk       String
  shelfLife          String
  visualAssessment   String?  // JSON stringified or text
  environmentalData  String?  // JSON stringified or text
  aiAssessment       String?  // JSON stringified or text
  recommendation     String?
  imageUrl           String?
  syncStatus         String   // PENDING, SYNCED
  createdAt          DateTime @default(now())
}

model MonitoringSession {
  id               Int      @id @default(autoincrement())
  batchId          Int
  batch            Batch    @relation(fields: [batchId], references: [id])
  aggregatorId     Int
  deviceId         Int
  device           Device   @relation(fields: [deviceId], references: [id])
  startedAt        DateTime
  endedAt          DateTime?
  status           String   // ACTIVE, COMPLETED
}
